.DS_Store
# build artifacts
app/vst3/build*/
app/vst3/host/build*/
app/target/
*.o
*.a
*.dSYM
# release binaries (use GitHub Releases)
app/dist/*.vst3/
app/dist/*.component/
app/MegaTune*.vst3/
app/MegaTune*.component/
